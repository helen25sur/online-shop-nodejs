<%- include('../includes/head.ejs') %>
  <link rel="stylesheet" href="/styles/form.css">
  <link rel="stylesheet" href="/styles/admin.css">
  <link rel="stylesheet" href="/styles/messages.css">
  </head>

  <body>
    <%- include('../includes/header.ejs'), { csrfToken: csrfToken } %>
      <main class="main-content grid-container">
        <section class="add-product grid-content">
          <h2 class="heading-sm">
            <%= pageTitle %>
          </h2>
          <form class="form txt body-txt" action="/login" method="post">
            <label for="email">Email:</label>
            <input type="email" name="email" id="email" placeholder="Email">
            <label for="password">Password:</label>
            <input type="password" name="password" id="password" placeholder="Password">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn solid content-center">Login</button>
          </form>
          <% if (errorMessage) { %>
            <div class="error-message">
              <%= errorMessage %>
            </div>
            <% } %>
              <% if (successMessage) { %>
                <div class="success-message">
                  <%= successMessage %>
                </div>
                <% } %>
                  <div class="txt body-txt flex-column center">
                    <p><a class="active" href="/reset-password">Forgot your password?</a></p>
                    <p>Don't have an account?<a class="active" href="/register"> Register here</a></p>
                  </div>
        </section>
      </main>
      <%- include('../includes/end.ejs') %>