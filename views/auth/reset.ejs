<%- include('../includes/head.ejs') %>
  <link rel="stylesheet" href="/styles/form.css">
  <link rel="stylesheet" href="/styles/admin.css">
  <link rel="stylesheet" href="/styles/messages.css">
  </head>

  <body>
    <%- include('../includes/header.ejs'), { csrfToken: csrfToken } %>
      <main class="main-content grid-container">
        <section class="add-product grid-content">
          <h2 class="heading-sm">
            <%= pageTitle %>
          </h2>
          <form class="form txt body-txt" action="/reset-password" method="post">
            <label for="email">Email:</label>
            <input type="email" name="email" id="email" placeholder="Email">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn solid content-center">Reset Password</button>
          </form>
          <% if (errorMessage) { %>
            <div class="error-message">
              <%= errorMessage %>
            </div>
            <% } %>
              <% if (successMessage) { %>
                <div class="success-message">
                  <%= successMessage %>
                </div>
                <% } %>
        </section>
      </main>
      <%- include('../includes/end.ejs') %>