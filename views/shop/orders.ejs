<%- include('../includes/head.ejs') %>
  </head>

  <body>
    <%- include('../includes/header.ejs') %>
      <% if(orders.length <= 0) { %>
        <h2>Nothing there!</h2>
      <% } else { %>
        <ul>
          <% orders.forEach(order => { %>
            <li>
              <h2># <%= order.id %></h2>
              <ul>
                <% order.products.forEach(product => { %>
                  <%= product.title  %> (<%= product.orderItem.quantity %>)
                <% }); %>
              </ul>
            </li>
          <% }); %>
        </ul>
      <% } %>
    <%- include('../includes/end.ejs') %>